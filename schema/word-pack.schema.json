{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hurest/vocatab-word-packs/blob/main/schema/word-pack.schema.json",
  "title": "vocatab word pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceLanguage",
    "targetLanguage",
    "name",
    "words"
  ],
  "properties": {
    "sourceLanguage": {
      "enum": ["en", "ja", "ko", "fr", "de"]
    },
    "targetLanguage": {
      "enum": ["en", "ja", "ko", "fr", "de"]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "thumbnailUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 50
      }
    },
    "localizations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "$ref": "#/$defs/localization"
        },
        "ja": {
          "$ref": "#/$defs/localization"
        },
        "ko": {
          "$ref": "#/$defs/localization"
        },
        "fr": {
          "$ref": "#/$defs/localization"
        },
        "de": {
          "$ref": "#/$defs/localization"
        }
      }
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/word"
      }
    }
  },
  "$defs": {
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "reading",
        "meaning"
      ],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "example": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    }
  }
}
